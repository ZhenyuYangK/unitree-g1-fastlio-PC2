# 复制为 script/local.env 后填写 PC2 实际值；本文件由 Bash source。
# 调用者导出的同名变量优先；相对数据/构建目录以 G1_WS 为基准。
# export G1_WS=/absolute/path/to/g1_slam_ws
G1_ROS_DISTRO=foxy
G1_ROS_SETUP=/opt/ros/foxy/setup.bash
G1_BUILD_DIR=build_pc2
G1_INSTALL_DIR=install_pc2
G1_LOG_DIR=log_pc2

# 可选 underlay。留空使用已配置的系统包；配置后必须存在。
# 推荐 local_setup.bash，避免继承原机器路径。
G1_PCL_SETUP=
G1_UNITREE_ROS2_SETUP=
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# 自定义 DDS/RMW 必须配对，g1_check 核实 ldd 实际解析路径与校验和。
G1_RMW_RELEASE_TEST=0
G1_RMW_SETUP=
G1_DDS_LIB_DIR=

# 必须按 PC2 现场填写；不从旧 JSON 继承网卡或地址。
G1_NETWORK_INTERFACE=
G1_HOST_IP=
G1_LIDAR_IP=
ROS_DOMAIN_ID=0
# 可显式设置与现场 CycloneDDS 版本相符的 CYCLONEDDS_URI。
# CYCLONEDDS_URI=file:///absolute/path/to/cyclonedds.xml
G1_ENABLE_RVIZ=1
# 全局自动定位总预算，从首帧同步扫描开始；PC2 性能调整需记录验收差异。
G1_LOCALIZATION_TIMEOUT_SEC=180.0
# P4 默认低速验证档 0.20 m/s；PC2 验收后可显式改为 target（1.0 m/s）。
# 两档转速上限均为 0.40 rad/s；切档必须停止并重启整个导航栈。
G1_NAV_PROFILE=safe

# 默认地图路径为 G1_WS/maps/ 下同名文件。
# G1_MAP_PCD=maps/map.pcd
# G1_MAP_PGM=maps/map_multilayer.pgm
# G1_MAP_YAML=maps/map_multilayer.yaml
# G1_WAYPOINTS_FILE=task_data/maps/laboratory_map_v1/waypoints.yaml
# G1_MISSIONS_FILE=task_data/missions/missions.yaml
# P5: -1 preserves current robot volume; explicit override accepts 0..100.
G1_AUDIO_VOLUME=-1
