<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_task_manager</name>
  <version>0.0.0</version>
  <description>Fixed waypoint and multi-point mission manager for Unitree G1</description>
  <maintainer email="g1test@example.com">g1test</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>g1_task_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>unique_identifier_msgs</depend>
  <depend>ament_index_python</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rmw_cyclonedds_cpp</test_depend>

  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
